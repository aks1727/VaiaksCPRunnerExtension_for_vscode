{
  "name": "vaiaksh-cp-runner",
  "displayName": "Vaiaksh CP Runner",
  "description": "A lightweight competitive programming runner for C++, Java, and Python.",
  "version": "0.0.1",
  "publisher": "aks1727",
  "icon": "img/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/aks1727/VaiaksCPRunnerExtension_for_vscode.git"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "author": {
    "name": "Akshat Kumar Sinha (AKS)",
    "github": "aks1727"
  },
  "activationEvents": [
    "workspaceContains:**/*.cpp",
    "workspaceContains:**/*.c",
    "workspaceContains:**/*.java",
    "workspaceContains:**/*.py"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vaiaksh-cp-runner.run",
        "title": "Vaiaksh CP Runner: Run"
      },
      {
        "command": "vaiaksh-cp-runner.openPanel",
        "title": "Vaiaksh CP Runner: Open Panel"
      }
    ],
    "keybindings": [
      {
        "command": "vaiaksh-cp-runner.run",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus"
      },
      {
        "command": "vaiaksh-cp-runner.openPanel",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c"
      }
    ],
    "configuration": {
      "title": "Vaiaksh CP Runner",
      "properties": {
        "vaiaksh-cp-runner.panelWidth": {
          "type": "number",
          "default": 30,
          "minimum": 10,
          "maximum": 90,
          "description": "Percentage of the screen width the CP Runner UI should occupy (10 to 90)."
        },
        "vaiaksh-cp-runner.timeout": {
          "type": "number",
          "default": 5000,
          "description": "Maximum execution time in milliseconds before terminating the process (TLE). By default set to 5sec"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "@typescript-eslint/eslint-plugin": "^7.11.0",
    "@typescript-eslint/parser": "^7.11.0",
    "eslint": "^8.57.0",
    "esbuild": "^0.21.5",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.4.5",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.4.0"
  }
}